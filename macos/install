#!/bin/zsh
set -eu
umask 077
code=${0:A:h}
if [[ -z ${QQ_BRIDGE_PROFILE:-} ]]; then exec "$code/bridge" install "$@"; fi
state=$QQ_BRIDGE_STATE
runtime=$QQ_BRIDGE_RUNTIME
label=$QQ_BRIDGE_LABEL
plist="$HOME/Library/LaunchAgents/$label.plist"
domain="gui/$(id -u)"
nodebin=$(command -v node)
codexbin=$(command -v codex)
bundled=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
[[ ! -x "$bundled" ]] || codexbin=$bundled
codexbin=${QQ_COLLAB_CODEX:-$codexbin}
# Validate private configuration before copying files or touching launchd.
"$nodebin" "$code/settings.cjs" "$state" "$QQ_BRIDGE_PROFILE"
paired=$("$nodebin" -e 'const s=require(process.argv[1]).loadSettings(process.argv[2],process.argv[3]);console.log(s.collaborationContact?"yes":"no")' "$code/settings.cjs" "$state" "$QQ_BRIDGE_PROFILE")
shared="$code/collaboration"
[[ -f "$shared/service.cjs" ]] || shared="$code/../collaboration"
if [[ "$paired" == yes && ! -f "$shared/service.cjs" ]]; then
  print -u2 'Paired collaboration requires the repository collaboration directory'; exit 1
fi
if [[ "$paired" == yes ]]; then "$nodebin" -e "require('node:sqlite').DatabaseSync" >/dev/null; fi
mkdir -p "$runtime" "$state" "${plist:h}"
print -r -- "$QQ_BRIDGE_PROFILE" > "$runtime/installed-profile.new.$$"
mv "$runtime/installed-profile.new.$$" "$runtime/installed-profile"
for file in mention.cjs group_chat.py mention_routing.py mention_dispatch.py install-mention bridge settings.cjs direct.cjs paired-dm.cjs native.cjs host.c Info.plist run worker.sb worker.cjs group.cjs events.cjs ipc.cjs mcp.cjs trigger.py triggerctl.py dispatcher.md; do
  if [[ "$code" != "$runtime" ]]; then cp "$code/$file" "$runtime/$file.new.$$"; mv "$runtime/$file.new.$$" "$runtime/$file"; fi
done
if [[ -f "$shared/service.cjs" && "$shared" != "$runtime/collaboration" ]]; then
  mkdir -p "$runtime/collaboration"
  for file in service.cjs engine.cjs worker.cjs writing.cjs transport.cjs mcp.cjs; do
    cp "$shared/$file" "$runtime/collaboration/$file.new.$$"
    mv "$runtime/collaboration/$file.new.$$" "$runtime/collaboration/$file"
  done
fi
chmod 700 "$runtime/run" "$runtime/bridge"
"$runtime/run" probe
/usr/bin/python3 - "$plist" "$runtime" "$state" "$label" "$QQ_BRIDGE_PROFILE" <<'PY'
from pathlib import Path
import plistlib,sys
plist,runtime,state,label,profile=sys.argv[1:]
config=dict(Label=label,ProgramArguments=[str(Path(runtime)/'bridge'),'--profile',profile,'serve'],RunAtLoad=True,
            KeepAlive=dict(SuccessfulExit=False),ThrottleInterval=10,ProcessType='Background',
            StandardOutPath=str(Path(state)/'kernel.log'),StandardErrorPath=str(Path(state)/'kernel.log'))
tmp=Path(plist+'.new');tmp.write_bytes(plistlib.dumps(config));tmp.replace(plist)
PY
if /bin/launchctl print "$domain/$label" >/dev/null 2>&1; then
  /bin/launchctl bootout "$domain/$label"
fi
/bin/launchctl bootstrap "$domain" "$plist"
# The paired assistant runs as an ordinary local Node process, outside the QQ native sandbox.
sidecar="$label.collaboration"
sideplist="$HOME/Library/LaunchAgents/$sidecar.plist"
side_mcp=qq-collaboration
[[ "$QQ_BRIDGE_PROFILE" == default ]] || side_mcp="qq-collaboration-$QQ_BRIDGE_PROFILE"
if /bin/launchctl print "$domain/$sidecar" >/dev/null 2>&1; then /bin/launchctl bootout "$domain/$sidecar"; fi
if [[ "$paired" == yes ]]; then
  mkdir -p "$QQ_BRIDGE_COLLAB_STATE"
  /usr/bin/python3 - "$sideplist" "$sidecar" "$nodebin" "$codexbin" "$runtime" "$state" "$QQ_BRIDGE_COLLAB_STATE" "$PATH" <<'PY'
from pathlib import Path
import plistlib,sys
plist,label,node,codex,runtime,state,collab_state,search_path=sys.argv[1:]
args=[node,str(Path(runtime)/'collaboration'/'service.cjs'),'serve','--state',collab_state,
      '--bridge-dir',state,'--socket','bridge.sock','--codex',codex]
evidence=Path(collab_state)/'collaboration-evidence.txt'
if evidence.is_file(): args+=['--evidence-file',str(evidence)]
config=dict(Label=label,ProgramArguments=args,RunAtLoad=True,KeepAlive=dict(SuccessfulExit=False),
            ThrottleInterval=10,ProcessType='Background',EnvironmentVariables={'PATH':search_path},
            StandardOutPath=str(Path(collab_state)/'collaboration.log'),StandardErrorPath=str(Path(collab_state)/'collaboration.log'))
tmp=Path(plist+'.new');tmp.write_bytes(plistlib.dumps(config));tmp.replace(plist)
PY
  /bin/launchctl bootstrap "$domain" "$sideplist"
  codex mcp add "$side_mcp" -- "$nodebin" "$runtime/collaboration/mcp.cjs" --state "$QQ_BRIDGE_COLLAB_STATE"
  print -r -- "$side_mcp" > "$runtime/collaboration-mcp-name"
elif [[ -f "$sideplist" ]]; then
  rm "$sideplist"
fi
if [[ "$paired" != yes && -f "$runtime/collaboration-mcp-name" && "$(<"$runtime/collaboration-mcp-name")" == "$side_mcp" ]]; then
  if codex mcp get "$side_mcp" --json >/dev/null 2>&1; then codex mcp remove "$side_mcp"; fi
  rm "$runtime/collaboration-mcp-name"
fi
codex mcp add "$QQ_BRIDGE_SERVER" -- /usr/bin/env "QQ_BRIDGE_NODE=$nodebin" "$runtime/bridge" --profile "$QQ_BRIDGE_PROFILE" mcp
